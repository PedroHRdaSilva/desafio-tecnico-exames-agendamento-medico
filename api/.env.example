# Porta da API
PORT=3333

# Origem do front-end liberada no CORS
CORS_ORIGIN=http://localhost:3000

# Conexão com o MongoDB local (serviço MongoDB do Windows)
MONGODB_URI=mongodb://localhost:27017/agendamento

# Segredo usado para assinar os tokens JWT (gere um valor forte e aleatório)
JWTSECRET=troque-por-um-segredo-forte

# SMTP (opcional). Se ficar vazio, a API usa uma conta de teste do Ethereal
# e mostra no terminal o link para visualizar o e-mail enviado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Agendamento <no-reply@agendamento.com>"

# URL do front usada no link de redefinição de senha
FRONTEND_URL=http://localhost:3000

# Caminho do catálogo de exames (opcional). Padrão: ../dados/exames.csv,
# relativo à pasta onde a API é iniciada (api/).
# EXAMS_CSV_PATH=../dados/exames.csv
